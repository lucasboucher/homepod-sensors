# Copy to collector/.env for Compose / Dokploy. Do not commit a filled .env.
# The real pairing file stays outside git and is bind-mounted at runtime.

# Host path to pairing.json (Compose mount source). Fictitious example only.
PAIRING_FILE_HOST=/absolute/path/to/pairing.json

# Path inside the container. Compose sets this; keep it as /app/pairing.json.
PAIRING_FILE=/app/pairing.json

# Any HTTP URL that accepts POST + application/json. Fictitious example only.
HTTP_ENDPOINT_URL=https://example.invalid/homepod-readings

# Optional. Compose defaults match the collector if these are omitted.
POLL_INTERVAL_SECONDS=60
HOMEKIT_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=10
